# RNP Digital scraper configuration
# Copy to .env and fill in your values.

# Base URL of the RNP Digital portal
RNP_URL=https://www.rnpdigital.com/shopping/login.jspx

# Credentials — composite format: user1:pass1~user2:pass2
# Multiple accounts supported (first is used by default).
# IMPORTANT: quote the value if passwords contain special chars (#, &, $, etc.)
RNP_CREDENTIALS="user1@example.com:pass1~user2@example.com:pass2"

# Legacy fallback (single account) if RNP_CREDENTIALS is not set:
# RNP_USERNAME=user@example.com
# RNP_PASSWORD=secret

# OpenRouter API key for LLM-based vehicle data extraction
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
